.row
  .col-lg-12
    %h1 Corte
    .row
      =render 'corte_list'
      .col-sm-6

        %h3 Inventario
        %ul.list-group
          -@inventario.each do |inventario|
            %li.list-group-item
              %span.badge=number_with_precision(inventario.existencia, :precision => 2)
              =inventario.compra.name
              %span.label.label-default=number_with_precision(@recetas[inventario.compra.name] + inventario.existencia, :precision => 2) if @recetas[inventario.compra.name]
              %span.label.label-default=number_with_precision(inventario.existencia, :precision => 2) if !@recetas[inventario.compra.name]


    .col-sm-12
      .pull-right{:style => 'text-align: right;'}
        Venta:
        =number_to_currency(@sales.sum(:total))
        %br
        Gastos:
        =number_to_currency(@gastos.sum(:precio))
        %br
        Caja Chica:
        -if @corte_anterior and @corte_anterior.caja
          =number_to_currency(@corte_anterior.caja)
        -else
          =number_to_currency(0)
        %br
        %h3
          Total:
          -if @corte_anterior and @corte_anterior.caja
            =number_to_currency(@sales.sum(:total)-@gastos.sum(:precio)+@corte_anterior.caja)
          -else
            =number_to_currency(@sales.sum(:total)-@gastos.sum(:precio))

        %br
        =form_for @corte, :html => { :class => 'pull-right hidden-print' } do |f|
          =f.text_field :caja, :placeholder => '¿Cuánto se queda en caja?', class: 'form-control'
          %br
          -if current_user and current_user.has_role? :admin
            =f.text_field :fecha, class: 'form-control'
            %br
          =f.submit 'Hacer Corte', class: 'btn-default btn'

%br
%br

.clearfix


