%h1 Listing inventarios

%table
  %tr
    %th Compra
    %th Existencia
    %th
    %th
    %th

  - @inventarios.each do |inventario|
    %tr
      %td= inventario.compra_id
      %td= inventario.existencia
      %td= link_to 'Show', inventario
      %td= link_to 'Edit', edit_inventario_path(inventario)
      %td= link_to 'Destroy', inventario, :method => :delete, :data => { :confirm => 'Are you sure?' }

%br

= link_to 'New Inventario', new_inventario_path
