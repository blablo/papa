%h2=number_to_currency(@saldo)
%h3 Cortes
%table.table
  %tr
    %th Día
    %th Ventas
    %th Gastos Caja
    %th Gastos
    %th Pollos
    %th Arrachera
    %th Picaña
    %th Costilla
    %th Chamorros
    %th Tacos


  -@ffirst.downto(@flast).each  do |date|
    -cortes = @cortes.where('date(fecha) = date(?)', (date-5.hours))
    -gastos = @gastos.where('date(created_at) = date(?)', (date-5.hours))
    %tr
      %td
        =l(date, :format => '%A').capitalize + ' - ' + date.strftime("%d/%m/%Y")
      %td
        -cortes.each do |corte|
          =link_to(number_to_currency(corte.total_venta), corte)
          %br
      %td
        -cortes.each do |corte|
          =number_to_currency corte.total_gastos
          %br
      %td
        =number_to_currency(gastos.sum(:precio))
      %td
        =number_with_precision(cortes.inject(0){|sum, corte| sum + (ActiveSupport::JSON.decode(corte.principales)['Pollo Crudo'] ? ActiveSupport::JSON.decode(corte.principales)['Pollo Crudo'] : 0) }, :precision => 2)

      %td
        =number_with_precision(cortes.inject(0){|sum, corte| sum + (ActiveSupport::JSON.decode(corte.principales)['Arrachera'] ? ActiveSupport::JSON.decode(corte.principales)['Arrachera'] : 0) }, :precision => 2)

      %td
        =number_with_precision(cortes.inject(0){|sum, corte| sum + (ActiveSupport::JSON.decode(corte.principales)['Picaña'] ? ActiveSupport::JSON.decode(corte.principales)['Picaña'] : 0) }, :precision => 2)
      %td
        =number_with_precision(cortes.inject(0){|sum, corte| sum + (ActiveSupport::JSON.decode(corte.principales)['Costilla'] ? ActiveSupport::JSON.decode(corte.principales)['Costilla'] : 0) }, :precision => 2)

      %td
        =number_with_precision(cortes.inject(0){|sum, corte| sum + (ActiveSupport::JSON.decode(corte.principales)['Chamorro'] ? ActiveSupport::JSON.decode(corte.principales)['Chamorro'] : 0) }, :precision => 2)
      %td
        =number_with_precision(cortes.inject(0){|sum, corte| sum + (ActiveSupport::JSON.decode(corte.principales)['Tacos'] ? ActiveSupport::JSON.decode(corte.principales)['Tacos'] : 0) }, :precision => 2)



  %tr
    %th
    %th=number_to_currency @cortes.sum(:total_venta)
    %th=number_to_currency @cortes.sum(:total_gastos)
    %th=number_to_currency @gastos.sum(:precio)
    %th


%h3 Gastos
%table.table
  %tr
    %th Día
    %th Gasto
    %th Precio
    %th Volumen


  - @gastos.each do |gasto|
    %tr
      %td=link_to gasto.created_at.strftime("%d/%m/%Y %H:%M"), gasto
      %td
        =gasto.compra.name
        %small="("+gasto.nota+")" unless gasto.nota.blank?
      %td=number_to_currency gasto.precio
      %td
        =gasto.volumen
        =gasto.compra.medida

  %tr
    %th
    %th=number_to_currency @gastos.sum(:precio)
